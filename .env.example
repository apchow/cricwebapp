# Signs session cookies. Generate one with: openssl rand -hex 32
# If unset, the app creates data/.session-secret on first boot (fine for local use).
CRICHUB_SECRET=

# Persistence. Leave unset for local development and the app uses data/crichub.json.
# Set it on Vercel (Vercel Postgres, Neon or Supabase) and the same document moves
# to Postgres — required for any serverless deploy, where the filesystem is read-only.
# Apply db/schema.sql once against the database first.
DATABASE_URL=

# Optional: live scores + upcoming internationals on the home page.
# Free tier (500 requests/day) at https://cricapi.com — leave blank and the
# home page shows a "live scores are switched off" panel instead.
# One currentMatches call returns both live and upcoming fixtures; the server
# caches it, so browser polls do not spend quota.
CRICAPI_KEY=

# Upper bound on upstream calls per day (default 450, under the free 500).
CRICAPI_DAILY_BUDGET=

# Absolute URL used by /sitemap.xml, /robots.txt and the social card. On Vercel
# this is optional — the project domain is picked up automatically. Set it only
# when hosting somewhere Vercel does not tell us about.
NEXT_PUBLIC_APP_URL=

# Password-reset email via Resend (https://resend.com). Leave blank and the
# "Forgot password?" request reports that reset email is not available yet.
# Set this on Vercel (Settings → Environment Variables) for production.
RESEND_API_KEY=

# Sender address. Resend's shared onboarding@resend.dev only delivers to the
# account owner's own inbox; to email any user you must verify a domain in
# Resend and set this to e.g. "Pundit Arena <no-reply@yourdomain.com>".
# Defaults to "Pundit Arena <onboarding@resend.dev>" when unset.
RESEND_FROM=

# Google sign-in (OAuth) — free, no domain needed. Create an "OAuth client ID"
# of type Web application at https://console.cloud.google.com/apis/credentials,
# then add BOTH of these as the client's Authorized redirect URIs:
#   https://punditarena.vercel.app/api/auth/google/callback
#   http://localhost:3000/api/auth/google/callback   (for local testing)
# Leave blank to hide the "Continue with Google" button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
