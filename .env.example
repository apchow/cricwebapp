# Signs session cookies. Generate one with: openssl rand -hex 32
# If unset, the app creates data/.session-secret on first boot (fine for local use).
CRICHUB_SECRET=

# Optional: live scores + upcoming internationals on the home page.
# Free tier (500 requests/day) at https://cricapi.com — leave blank and the
# home page shows a "live scores are switched off" panel instead.
# One currentMatches call returns both live and upcoming fixtures; the server
# caches it, so browser polls do not spend quota.
CRICAPI_KEY=

# Upper bound on upstream calls per day (default 450, under the free 500).
CRICAPI_DAILY_BUDGET=
